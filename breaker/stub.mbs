            <scriptInit>import random, math
_mb_start = time()
nm = mbdevice.getname()
try:
    idx = int(nm.rsplit('-', 1)[1])
except Exception:
    idx = 0
random.seed(idx * 2027 + 3)
TOTAL = 310
WAIT = 270
POFF = (idx % 4) * 75
_p_fault = 0.05
_f1_left = 0
_f2_left = 0
_prev_stage = -1
_manual_left = 0
_start_prev = False
_px = 0.0
_py = 0.0
_pz = 0.0
mem3x.setuint32(3, 0)
mem3x.setuint32(5, 0)
mem3x.setuint32(7, 0)
mem3x.setuint16(2, 30)
mem0x.setbit(0, True)
mem0x.setbit(1, True)
